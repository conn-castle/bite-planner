# Public client configuration (bundled into the app; not secrets), shared by all modes.
# Branch-specific URLs: .env.production (`pnpm build`, TestFlight: Neon `main`) and
# .env.development (`pnpm dev`: Neon `dev`).
# Trusted Neon Auth domain presented as the Origin by the iOS app (its
# capacitor:// origin cannot be trusted) and by the dev server's auth proxy.
# Configured on each Neon branch. See src/lib/auth/neonAuth.ts and vite.config.ts.
VITE_NEON_AUTH_TRUSTED_ORIGIN=https://app.example.test
