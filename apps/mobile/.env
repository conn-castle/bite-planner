# Public client configuration (bundled into the app; not secrets).
# Values for the Neon `main` branch of project castle-chef (example-project).
VITE_NEON_AUTH_URL=https://auth.example.test/neondb/auth
VITE_NEON_DATA_API_URL=https://deployment-d9c17e32.example.test/neondb/rest/v1
# Trusted Neon Auth domain presented as the Origin by the iOS app (its
# capacitor:// origin cannot be trusted) and by the dev server's auth proxy.
# See src/neon.ts and vite.config.ts.
VITE_NEON_AUTH_TRUSTED_ORIGIN=https://app.example.test
