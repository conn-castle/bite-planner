#!/usr/bin/env bash
# Moves the worker to the latest Castle Chef release. Run every 5 minutes by
# castle-chef-update.timer as the `castle-chef` user, from its deployment
# clone (~/app). See README "Worker deployment".
#
# Follows only releases created by the release workflow (which migrates Neon
# before publishing), checks out the release's commit, and restarts the worker
# after any running job finishes. If the new release's worker does not start,
# it goes back to the previous commit and never retries that release. Other
# failures (network, package downloads) restore the previous commit and are
# retried on the next run.
#
# Needs GITHUB_TOKEN (fine-grained, this repository, Contents: read) from
# ~/.config/castle-chef/github.env.
set -euo pipefail

REPO=nicholasjconn/castle-chef
APP_DIR=$HOME/app
STATE_DIR=$HOME/.local/state/castle-chef
BAD_RELEASES=$STATE_DIR/bad-releases
# The worker's log file (castle_chef.settings.logs_dir); the updater logs there too.
LOG_FILE=$STATE_DIR/logs/castle-chef.jsonl
UNIT_DIR=$HOME/.config/systemd/user
WORKER=castle-chef-worker.service
START_TIMEOUT_SECONDS=120

# Structured log line, like the worker's: log LEVEL EVENT [--arg KEY VALUE]...
log() {
  local level=$1 event=$2 line
  shift 2
  line=$(jq -nc --arg ts "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" --arg level "$level" \
    --arg logger castle_chef.update --arg event "$event" "$@" '$ARGS.named')
  echo "$line" >&2
  mkdir -p "$(dirname "$LOG_FILE")"
  echo "$line" >> "$LOG_FILE"
}

git_app() {
  # The token comes from the environment, so it is never stored in git config.
  # shellcheck disable=SC2016  # $GITHUB_TOKEN is expanded by git's credential helper
  git -C "$APP_DIR" \
    -c credential.helper='!f() { echo username=x-access-token; echo "password=$GITHUB_TOKEN"; }; f' \
    "$@"
}

# Check out a fetched commit and prepare it; the worker must be stopped. Called
# in `if`, where `set -e` does not apply, so every step checks its own result.
deploy() {
  local sha=$1 unit changed=false
  git_app checkout --quiet --force --detach "$sha" || return 1
  (cd "$APP_DIR/backend" && uv sync --quiet --frozen --no-dev) || return 1
  (cd "$APP_DIR" && al sync > /dev/null) || return 1
  mkdir -p "$UNIT_DIR" || return 1
  for unit in castle-chef-worker.service castle-chef-update.service castle-chef-update.timer; do
    if ! cmp -s "$APP_DIR/deploy/$unit" "$UNIT_DIR/$unit"; then
      cp "$APP_DIR/deploy/$unit" "$UNIT_DIR/$unit" || return 1
      changed=true
    fi
  done
  if [ "$changed" = true ]; then
    systemctl --user daemon-reload || return 1
  fi
}

# Log lines written since byte `offset` of the log file, across one rotation.
log_since() {
  local offset=$1
  if [ ! -f "$LOG_FILE" ]; then
    return 0
  fi
  if [ "$(stat -c %s "$LOG_FILE")" -lt "$offset" ]; then
    tail -c "+$((offset + 1))" "$LOG_FILE.1" 2> /dev/null || true
    cat "$LOG_FILE"
  else
    tail -c "+$((offset + 1))" "$LOG_FILE"
  fi
}

# Start the worker; succeed once it logs worker.started for this commit.
start_worker() {
  local sha=$1 offset=0 deadline
  if [ -f "$LOG_FILE" ]; then
    offset=$(stat -c %s "$LOG_FILE")
  fi
  systemctl --user start "$WORKER" || return 1
  deadline=$((SECONDS + START_TIMEOUT_SECONDS))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if log_since "$offset" |
      jq -Re --arg sha "$sha" 'fromjson? | select(.event == "worker.started" and .commit == $sha)' \
        > /dev/null; then
      return 0
    fi
    if systemctl --user is-failed --quiet "$WORKER"; then
      return 1
    fi
    sleep 2
  done
  return 1
}

main() {
  local release tag sha author current
  : "${GITHUB_TOKEN:?Set GITHUB_TOKEN in ~/.config/castle-chef/github.env}"

  release=$(curl -fsS -H "Authorization: Bearer $GITHUB_TOKEN" \
    -H "Accept: application/vnd.github+json" "https://api.github.com/repos/$REPO/releases/latest")
  tag=$(jq -r .tag_name <<< "$release")
  sha=$(jq -r .target_commitish <<< "$release")
  author=$(jq -r .author.login <<< "$release")

  if [ "$author" != "github-actions[bot]" ]; then
    log error update.untrusted_release --arg release "$tag" --arg author "$author"
    echo "Release $tag was not created by the release workflow (author $author); not deploying it." >&2
    exit 1
  fi
  if ! [[ $sha =~ ^[0-9a-f]{40}$ ]]; then
    log error update.invalid_release --arg release "$tag" --arg target "$sha"
    echo "Release $tag targets '$sha', not a commit SHA; not deploying it." >&2
    exit 1
  fi

  current=$(git_app rev-parse HEAD)
  if [ "$sha" = "$current" ] ||
    { [ -f "$BAD_RELEASES" ] && grep -qx "$sha" "$BAD_RELEASES"; }; then
    ensure_worker_running
    exit 0
  fi

  # Fetch while the worker still runs: a network failure leaves it untouched.
  if ! git_app fetch --quiet --tags origin; then
    log error update.fetch_failed --arg release "$tag" --arg commit "$sha"
    exit 1
  fi
  log info update.started --arg release "$tag" --arg commit "$sha" --arg from "$current"
  # Blocks until a running job finishes (the worker handles SIGTERM gracefully).
  systemctl --user stop "$WORKER"
  if ! deploy "$sha"; then
    # Not the release's fault (e.g. a package download failed): retried next run.
    log error update.deploy_failed --arg release "$tag" --arg commit "$sha"
    restore "$current" "$tag" "$sha"
    exit 1
  fi
  if start_worker "$sha"; then
    log info update.finished --arg release "$tag" --arg commit "$sha"
    exit 0
  fi

  mkdir -p "$STATE_DIR"
  echo "$sha" >> "$BAD_RELEASES"
  restore "$current" "$tag" "$sha"
  echo "The worker did not start on $tag ($sha); see $LOG_FILE and journalctl --user -u $WORKER." >&2
  exit 1
}

# Go back to the commit that ran before, and start the worker whatever happens.
restore() {
  local previous=$1 tag=$2 sha=$3
  systemctl --user stop "$WORKER" || true
  systemctl --user reset-failed "$WORKER" 2> /dev/null || true
  if deploy "$previous" && start_worker "$previous"; then
    log error update.rolled_back --arg release "$tag" --arg commit "$sha" --arg restored "$previous"
  else
    systemctl --user start "$WORKER" || true
    log critical update.rollback_failed --arg release "$tag" --arg commit "$sha" \
      --arg restored "$previous"
  fi
}

# After a failed rollback the worker may be stopped; start it unless it has
# failed on its own (e.g. `schema.behind`, which must stay visible).
ensure_worker_running() {
  if ! systemctl --user is-active --quiet "$WORKER" &&
    ! systemctl --user is-failed --quiet "$WORKER"; then
    log warning update.worker_restarted
    systemctl --user start "$WORKER"
  fi
}

# One compound command, so bash has read it all before an update rewrites this
# file; the exit is a guard in case main ever returns.
# shellcheck disable=SC2317
{ main "$@"; exit $?; }
