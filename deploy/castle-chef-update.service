# Moves the worker to the latest release; started by castle-chef-update.timer.
# See castle-chef-update and README "Worker deployment".
[Unit]
Description=Update the Castle Chef worker to the latest release

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/castle-chef/github-app.env
ExecStart=%h/app/deploy/castle-chef-update
# Stopping the worker waits for a running job (up to 20 minutes).
TimeoutStartSec=30min
